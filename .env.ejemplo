# Copia este archivo como ".env" (sin la palabra ejemplo) y llena tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Token que te da @BotFather en Telegram
TELEGRAM_TOKEN=pega_aqui_tu_token

# IDs de Telegram del personal que puede usar /lote, /acuse_demo, /recordar y /tablero.
# Para saber tu ID, escríbele /miid al bot. Si son varios, sepáralos con comas.
ADMIN_IDS=
